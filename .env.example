# Konfigurasi Environment — Salin file ini menjadi .env dan sesuaikan isinya

# ========================
# DATABASE
# ========================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_surat_tugas
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ========================
# APLIKASI
# ========================
APP_ENV=production
APP_URL=https://yourdomain.com

# ========================
# CATATAN
# ========================
# File .env TIDAK boleh di-commit ke repository!
# Pastikan .env sudah masuk .gitignore
